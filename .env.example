# Required: Claude Agent SDK gateway (do not commit real values)
KAON_GATEWAY_BASE_URL=https://<agent-gateway-host>
KAON_GATEWAY_MODEL=deepseek-v4-flash
KAON_GATEWAY_API_KEY=<secret>

# Optional but recommended: Langfuse tracing
LANGFUSE_PUBLIC_KEY=<secret>
LANGFUSE_SECRET_KEY=<secret>
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_TRACING_ENVIRONMENT=production
LANGFUSE_PROJECT_ID=<langfuse-project-id>
LANGFUSE_AGENT_ID=emochi-agent
LANGFUSE_AGENT_VERSION=5.11.0

# Required only when enabling image generation
IMAGE_GATEWAY_BASE_URL=https://<image-gateway-host>
IMAGE_GATEWAY_MODEL=<image-model>
IMAGE_GATEWAY_API_KEY=<secret>

# Local server only; defaults to 8789.
AGENT_PORT=8789
# Optional local persistent data location. Defaults to ./data.
# EMOCHI_DATA_DIR=/absolute/path/outside/this/repository
